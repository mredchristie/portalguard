[0.001, "o", "\u001b[?2004l\u001b[>4;0m\u001b[=0u\u001b>"]
[0.772, "o", "\r\n"]
[0.000, "o", "\u001b[30m\u001b(B\u001b[m\u001b]133;C;cmdline_url=make%20e2e-redact\u0007"]
[0.002, "o", "\u001b]0;make e2e-redact ~/D/portalguard\u0007\u001b[30m\u001b(B\u001b[m\r"]
[0.047, "o", "go build -ldflags \"-X main.version=d0f1af4-dirty\" -o bin/portalguard ./cmd/portalguard\r\n"]
[0.294, "o", "this needs root and CUTS THE NETWORK several times on purpose.\r\n"]
[0.000, "o", "sudo ./testenv/e2e.sh --redact\r\n"]
[0.025, "o", "Password:"]
[5.610, "o", "\r\n"]
[0.203, "o", "\r\n\u001b[1m== PRECONDITIONS\u001b[0m\r\n"]
[0.010, "o", "   binary is current\r\n"]
[0.004, "o", "   off-box target (gateway): 192.168.0.1\r\n   fake portal (loopback):   http://127.0.0.1:8080\r\n"]
[0.000, "o", "   control host:             1.1.1.1\r\n"]
[0.000, "o", "   \u001b[1mredaction: ON  - both PHASE B and PHASE D display categories only\u001b[0m\r\n"]
[0.111, "o", "   fake portal reset to intercepting\r\n"]
[0.000, "o", "\r\n\u001b[1m== PHASE A -- LOCKED_DOWN blocks a genuinely off-box target\u001b[0m\r\n"]
[0.000, "o", "   $ ./bin/portalguard lockdown\r\n"]
[0.341, "o", "portalguard: all traffic blocked. run `sudo portalguard release` to undo\r\n"]
[6.018, "o", "   \u001b[32mPASS\u001b[0m gateway blocked while locked down (over en0) (curl exit 28)\r\n"]
[0.023, "o", "   \u001b[32mPASS\u001b[0m loopback still works while locked down\r\n"]
[0.006, "o", "   \u001b[32mPASS\u001b[0m no gap open during a bare lockdown\r\n"]
[0.014, "o", "portalguard: rules released; normal networking restored\r\n"]
[0.093, "o", "   \u001b[32mPASS\u001b[0m gateway reachable again after release\r\n"]
[0.001, "o", "\r\n\u001b[1m== PHASE B -- the full cycle, driven by the real CLI\u001b[0m\r\n"]
[0.008, "o", "   $ ./bin/portalguard run -probes-file testenv/probes.json -wait 90s -redact -audit-log <not printed> &   (output -> /var/folders/zz/zyxvpxvq6csfxvn_n0000000000000/T/portalguard-e2e.ubfEm0LPFY)\r\n"]
[0.001, "o", "   waiting for GAP_OPEN"]
[0.004, "o", "."]
[1.019, "o", "\r\n\r\n\u001b[1m== PHASE B1 -- GAP_OPEN lets the portal through and nothing else\u001b[0m\r\n"]
[0.005, "o", "   \u001b[32mPASS\u001b[0m gap pinned to the gateway address\r\n"]
[0.088, "o", "   \u001b[32mPASS\u001b[0m portal reachable through the gap (over en0)\r\n"]
[6.025, "o", "   \u001b[32mPASS\u001b[0m control host still blocked -- the gap is narrow (curl exit 28)\r\n"]
[0.023, "o", "   \u001b[32mPASS\u001b[0m loopback still works\r\n"]
[0.005, "o", "   \u001b[32mPASS\u001b[0m pflog1 created for the leak log\r\n"]
[0.000, "o", "\r\n\u001b[1m== PHASE B2 -- AUTHENTICATED\u001b[0m\r\n"]
[0.000, "o", "   simulating the human clicking Accept on the fake portal\r\n"]
[0.000, "o", "   $ curl -s -o /dev/null -X POST http://127.0.0.1:8080/accept\r\n"]
[0.012, "o", "   waiting for the re-probe to succeed and seal"]
[0.000, "o", "."]
[1.008, "o", "."]
[1.009, "o", "\r\n"]
[0.001, "o", "\r\n\u001b[1m== PHASE B3 -- SEALED closes the gap again\u001b[0m\r\n"]
[6.030, "o", "   \u001b[32mPASS\u001b[0m gateway blocked again after seal (curl exit 28)\r\n"]
[0.026, "o", "   \u001b[32mPASS\u001b[0m loopback still works while sealed\r\n"]
[0.006, "o", "   \u001b[32mPASS\u001b[0m pg_portal emptied by the seal\r\n"]
[0.004, "o", "   \u001b[32mPASS\u001b[0m pg_dns emptied by the seal\r\n"]
[0.032, "o", "   \u001b[32mPASS\u001b[0m status reports LOCKED after seal, not GAP\r\n"]
[0.036, "o", "   \u001b[32mPASS\u001b[0m status lists nothing as allowed after seal\r\n\r\n\u001b[1m== PHASE B4 -- the leak report is real\u001b[0m\r\n"]
[0.003, "o", "   \u001b[32mPASS\u001b[0m report was printed at seal\r\n"]
[0.003, "o", "   \u001b[32mPASS\u001b[0m report counted 57 outbound packets held back (non-zero)\r\n"]
[0.003, "o", "   \u001b[32mPASS\u001b[0m report does not let a packet count read as a query count\r\n"]
[0.002, "o", "   \u001b[32mPASS\u001b[0m report states how long the gap was open\r\n"]
[0.006, "o", "   \u001b[32mPASS\u001b[0m report is explicit about whether it knows the hostnames\r\n"]
[0.006, "o", "   \u001b[32mPASS\u001b[0m enriched report names at least one hostname (Hostnames queried: other (6 hostnames))\r\n"]
[0.003, "o", "   \u001b[32mPASS\u001b[0m PHASE B's displayed line has the category shape, not raw domains\r\n"]
[0.039, "o", "   \u001b[32mPASS\u001b[0m none of PHASE B's real hostnames (verified via the unprinted audit log) reached the displayed report\r\n\r\n   --- report as printed ---\r\n"]
[0.003, "o", "   --- what happened while portalguard was engaged ---\r\n   The gap was open for 8s.\r\n   Held back 57 packets (22.7 kB) your machine tried to send while locked down.\r\n   Dropped 20 packets (2.0 kB) the network tried to send you.\r\n   The login page itself accounted for 20 packets (15.7 kB).\r\n   \r\n   28 packets (3.1 kB) went out through the DNS hole, to 192.168.0.1, fd12:3456:789a::53.\r\n   That is packets, not lookups: a query and its reply are counted separately.\r\n   Hostnames queried: other (6 hostnames)\r\n   The kernel did not attribute these queries to a process.\r\n   \r\n"]
[0.000, "o", "   Source: pf rule counters, pfctl -a portalguard -s rules -v\r\n   ---\r\n"]
[0.000, "o", "\r\n\u001b[1m== PHASE C -- release restores the machine\u001b[0m\r\n"]
[0.014, "o", "portalguard: rules released; normal networking restored\r\n"]
[0.087, "o", "   \u001b[32mPASS\u001b[0m gateway reachable after release\r\n"]
[0.004, "o", "   \u001b[32mPASS\u001b[0m pg_portal empty after release\r\n"]
[0.003, "o", "   \u001b[32mPASS\u001b[0m pg_dns empty after release\r\n"]
[0.003, "o", "   \u001b[32mPASS\u001b[0m pflog1 destroyed\r\n"]
[0.000, "o", "\r\n\u001b[1m== PHASE D -- -redact through the real binary, not just unit tests\u001b[0m\r\n"]
[0.011, "o", "   fake portal reset to intercepting\r\n"]
[0.006, "o", "   $ ./bin/portalguard run -probes-file testenv/probes.json -wait 90s -redact -audit-log <not printed> &   (output -> /var/folders/zz/zyxvpxvq6csfxvn_n0000000000000/T/portalguard-e2e-redact.eKLsf4nmTP)\r\n"]
[0.000, "o", "   waiting for GAP_OPEN"]
[0.003, "o", "."]
[1.017, "o", "\r\n   simulating the human clicking Accept on the fake portal\r\n"]
[0.000, "o", "   $ curl -s -o /dev/null -X POST http://127.0.0.1:8080/accept\r\n"]
[0.019, "o", "   waiting for the re-probe to succeed and seal"]
[0.000, "o", "."]
[1.010, "o", "."]
[1.011, "o", "\r\n"]
[0.019, "o", "   \u001b[32mPASS\u001b[0m redacted report still names at least one category (Hostnames queried: other (2 hostnames), streaming/media (1 hostname))\r\n"]
[0.004, "o", "   \u001b[32mPASS\u001b[0m redacted entries have the category (N hostnames) shape, not raw domains\r\n"]
[0.026, "o", "   \u001b[32mPASS\u001b[0m none of this run's real hostnames (verified via the unprinted audit log) reached the displayed report\r\n"]
[0.013, "o", "portalguard: rules released; normal networking restored\r\n"]
[0.076, "o", "   \u001b[32mPASS\u001b[0m gateway reachable after the redaction cycle's release\r\n\r\n\u001b[1m== RESULT\u001b[0m\r\n"]
[0.000, "o", "   \u001b[32mall assertions passed\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[1m== TEARDOWN (always runs)\u001b[0m\r\n"]
[0.018, "o", "   anchor flushed. network should be back.\r\n"]
